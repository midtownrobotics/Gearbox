diff --git a/src/shared/renderers/field3d/workers/gearboxFiles.ts b/src/shared/renderers/field3d/workers/gearboxFiles.ts
new file mode 100644
index 0000000..5a31f75
--- /dev/null
+++ b/src/shared/renderers/field3d/workers/gearboxFiles.ts
@@ -0,0 +1,33 @@
+// Gearbox: the page fetches a 3D worker's models and hands them over, rather than the worker
+// fetching them. Firefox sends a worker's own requests past Pit's service worker, which keeps
+// the models on the device, so without a connection they failed.
+
+import { GLTF, GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
+
+/** A model and the ones beside it (model.glb, model_0.glb, ...), as their paths. */
+export function modelPaths(path: string, count: number): string[] {
+  return [path, ...Array.from({ length: count }, (_, index) => path.slice(0, -4) + "_" + index.toString() + ".glb")];
+}
+
+/** On the page: each file's bytes, by path (one that can't be fetched is left for the worker). */
+export async function fetchFiles(paths: string[]): Promise<{ [path: string]: ArrayBuffer }> {
+  const files: { [path: string]: ArrayBuffer } = {};
+  await Promise.all(
+    paths.map(async (path) => {
+      try {
+        const response = await fetch(path);
+        if (response.ok) files[path] = await response.arrayBuffer();
+      } catch (e) {}
+    })
+  );
+  return files;
+}
+
+/** In the worker: the model from the bytes the page sent, else fetched as before. */
+export function loadModel(loader: GLTFLoader, files: { [path: string]: ArrayBuffer } | undefined, path: string) {
+  return new Promise<GLTF>((resolve) => {
+    const file = files?.[path];
+    if (file) loader.parse(file, "", resolve, (error) => console.error(error));
+    else loader.load(path, resolve);
+  });
+}
