diff --git a/src/main/lite/teamStorage.ts b/src/main/lite/teamStorage.ts
new file mode 100644
index 0000000..4b91ca1
--- /dev/null
+++ b/src/main/lite/teamStorage.ts
@@ -0,0 +1,64 @@
+// Gearbox: AdvantageScope Lite's preferences and layout belong to the team, not to one browser.
+// Pit keeps them (GET/PUT /api/scope/settings), and main.ts reads and writes them through this
+// `localStorage` in place of the browser's.
+
+const ENDPOINT = "/api/scope/settings";
+const SAVE_DELAY_MS = 1000;
+
+const values = new Map<string, string>();
+const unsaved = new Map<string, string>();
+let loaded = false;
+let saveTimer: number | null = null;
+
+/** Resolves once the team's settings are in (or couldn't be read: then nothing is saved). */
+export const storageReady: Promise<void> = (async () => {
+  try {
+    const response = await fetch(ENDPOINT, { credentials: "same-origin" });
+    if (response.status === 401) {
+      // Signed out: to the team's sign-in page, coming back here.
+      location.replace("/api/scope/sign-in?return=" + encodeURIComponent(location.href));
+      await new Promise(() => {});
+    }
+    if (!response.ok) return;
+    const body = (await response.json()) as { settings: { [key: string]: string } };
+    for (const [key, value] of Object.entries(body.settings)) values.set(key, value);
+    loaded = true;
+  } catch {
+    // Offline: the defaults, without overwriting what the team has saved.
+  }
+})();
+
+function save(keepalive = false) {
+  if (saveTimer !== null) {
+    window.clearTimeout(saveTimer);
+    saveTimer = null;
+  }
+  if (unsaved.size === 0) return;
+  const body = JSON.stringify({ settings: Object.fromEntries(unsaved) });
+  unsaved.clear();
+  fetch(ENDPOINT, {
+    method: "PUT",
+    credentials: "same-origin",
+    headers: { "Content-Type": "application/json" },
+    body: body,
+    keepalive: keepalive && body.length < 60000
+  }).catch(() => {});
+}
+
+window.addEventListener("pagehide", () => save(true));
+document.addEventListener("visibilitychange", () => {
+  if (document.visibilityState === "hidden") save(true);
+});
+
+export const localStorage = {
+  getItem(key: string): string | null {
+    return values.get(key) ?? null;
+  },
+  setItem(key: string, value: string) {
+    if (values.get(key) === value) return;
+    values.set(key, value);
+    if (!loaded) return;
+    unsaved.set(key, value);
+    if (saveTimer === null) saveTimer = window.setTimeout(() => save(), SAVE_DELAY_MS);
+  }
+};
