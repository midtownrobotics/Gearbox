# Local dev: fake counters, pushes to the local edge worker every 30s.
EDGE_WORKER_URL=http://localhost:8793
EDGE_AGENT_KEY=local-dev-agent-key
EDGE_DB_PATH=./.data/agent.db
EDGE_HTTP_PORT=8700
EDGE_MOCK=1
EDGE_COLLECT_INTERVAL=30
EDGE_DNSMASQ_CONF=./.data/dnsmasq/g3-edge.conf
EDGE_DRIVE_DIR=./.data/drive
EDGE_DRIVE_HOST=127.0.0.1
EDGE_DRIVE_PORT=8780
EDGE_SWITCH_POLL_MS=25
EDGE_SWITCH_DEBOUNCE_MS=75
EDGE_SWITCH_SOUNDS=./sounds/switch.wav
EDGE_SWITCH_SOUND_DIR=./.data/sounds
EDGE_SWITCH_AUDIO_DEVICE=plughw:CARD=rockchipes8388,DEV=0
