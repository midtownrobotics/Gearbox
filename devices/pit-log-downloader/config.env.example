# Optional settings: the downloader runs without this file, and gets its team by pairing with
# Gearbox on its status page. To change any of these, copy this file to config.env.

# The Google Drive folder logs are copied to, from its address:
# https://drive.google.com/drive/folders/<FOLDER ID>
# Leave it empty to keep logs on this computer only.
DRIVE_FOLDER_ID=

# The Google service account's key file, which needs access to that folder.
# Relative paths start from this folder.
GOOGLE_KEY_FILE=service-account-key.json

# Where downloaded logs are kept. Relative paths start from this folder.
DATA_DIR=data

# The status page, at http://localhost:3000. Set HOST=0.0.0.0 to open it to other computers.
PORT=3000
HOST=127.0.0.1

# The Pit to pair with, when it isn't your team's usual address (https://<team>-pit.frcgearbox.com),
# such as staging. For the Pit under `pnpm dev`, start the downloader with `-- --dev` instead.
PIT_URL=
