{
  "name": "@g3/pit-log-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=config.env src/index.ts",
    "watch": "node --env-file-if-exists=config.env --watch-path=src src/index.ts",
