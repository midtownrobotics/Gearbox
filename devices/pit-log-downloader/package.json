{
  "name": "@g3/pit-log-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build && node --env-file-if-exists=config.env src/index.ts",
    "watch": "node --env-file-if-exists=config.env --watch-path=src src/index.ts --watch-page",
    "build": "vite build",
    "smoke": "vite build && node scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@g3/site-config": "workspace:*",
    "express": "^5.2.1",
    "is-online": "^12.0.2",
    "node-ssh": "^13.2.1"
  },
  "devDependencies": {
    "@g3/ui": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.5"
  }
}
