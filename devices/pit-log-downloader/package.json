    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "is-online": "^12.0.2",
    "node-ssh": "^13.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.8.0"
  }
}
