# /etc/g3-edge/agent.env — root:root, mode 600. Never commit the real file.

# workers/edge base URL.
EDGE_WORKER_URL=https://1648-edge.frcgearbox.com/api

# The team's box key: made by an admin on the Edge app's Edge Box page (shown once).
# Generate with: openssl rand -hex 32
EDGE_AGENT_KEY=replace-me

# Optional overrides (defaults shown).
#EDGE_DB_PATH=/var/lib/g3-edge/agent.db
#EDGE_HTTP_PORT=8700
#EDGE_WAN_IF=wan0
#EDGE_LAN_IF=lan0
#EDGE_LAN_IP=192.168.50.1
#EDGE_LEASES_PATH=/var/lib/misc/dnsmasq.leases
#EDGE_DNS_LOG=/run/g3-edge-dns/queries.log
#EDGE_DNSMASQ_CONF=/var/lib/g3-edge/dnsmasq/g3-edge.conf
#EDGE_COLLECT_INTERVAL=300

# Optional: DigiKey API app for part lookup ("Product Information V4" at developer.digikey.com).
#EDGE_DIGIKEY_CLIENT_ID=
#EDGE_DIGIKEY_CLIENT_SECRET=

# Door microswitch: closed shorts the input to ground; opening plays audio.
# The placeholder POST /switch/input takes {"grounded": true|false}.
#EDGE_SWITCH_POLL_MS=25
#EDGE_SWITCH_DEBOUNCE_MS=75
#EDGE_SWITCH_SOUNDS=/srv/g3-sounds/switch.wav
#EDGE_SWITCH_AUDIO_PLAYER=aplay
# Orange Pi 5 analog headphone jack (ES8388 codec). Check `aplay -l` if your image names it differently.
#EDGE_SWITCH_AUDIO_DEVICE=plughw:CARD=rockchipes8388,DEV=0
#EDGE_SWITCH_SOUND_DIR=/srv/g3-sounds
# Orange Pi 5 GPIO2_D4 = physical pin 22 = Linux GPIO 92.
#EDGE_SWITCH_GPIO_VALUE_PATH=/sys/class/gpio/gpio92/value
