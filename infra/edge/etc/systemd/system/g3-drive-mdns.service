[Unit]
Description=Announce drive.local (the shop drive) on the shop network over mDNS
After=avahi-daemon.service
Requires=avahi-daemon.service

[Service]
# Needs the avahi-utils package. Keeps drive.local -> the box's LAN address
# published for as long as it runs.
ExecStart=/usr/bin/avahi-publish --address --no-reverse drive.local 192.168.50.1
Restart=always
RestartSec=10
# Not DynamicUser: Armbian's nsswitch.conf can't look dynamic users up, and D-Bus
# then refuses avahi-publish ("An unexpected D-Bus error occurred").
User=avahi

[Install]
WantedBy=multi-user.target
