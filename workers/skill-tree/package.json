{
  "name": "@g3/worker-skill-tree",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8790 --inspector-port 9232",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply SKILL_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SKILL_DB --env production --remote",
    "test": "vitest run",
    "build": "wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/site-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@g3/testing": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.14.0"
  }
}
