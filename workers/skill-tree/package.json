  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/site-config": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "^4.20250516.0",
    "@g3/testing": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.14.0"
  }
}
