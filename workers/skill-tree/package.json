{
  "name": "@g3/worker-skill-tree",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8790 --inspector-port 9232",
    "deploy": "wrangler deploy",
