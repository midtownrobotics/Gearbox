{
  "name": "@g3/worker-pit",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8789 --inspector-port 9231",
    "build": "wrangler deploy --env production --dry-run",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply PIT_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PIT_DB --env production --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "^4.20250516.0",
    "@g3/testing": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.14.0"
  }
}
