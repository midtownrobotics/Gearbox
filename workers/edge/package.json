{
  "name": "@g3/worker-edge",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./print-types": "./src/modules/print/types.ts",
    "./lookup-types": "./src/modules/lookup/types.ts",
    "./switch-types": "./src/modules/switch/types.ts",
    "./presence-types": "./src/modules/network/presence-types.ts",
    "./interface-types": "./src/modules/network/interface-types.ts",
    "./link-protocol": "./src/lib/link-protocol.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8793 --inspector-port 9235",
    "build": "wrangler deploy --env production --dry-run",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply EDGE_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply EDGE_DB --env production --remote",
    "test": "vitest run",
    "box-key:set": "node scripts/set-box-key.ts"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/site-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@g3/testing": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.110.0"
  }
}
