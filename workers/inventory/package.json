{
  "name": "@g3/worker-inventory",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./intake-types": "./src/lib/intake-types.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8797 --inspector-port 9239",
    "build": "wrangler deploy --env production --dry-run",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply INVENTORY_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply INVENTORY_DB --env production --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/site-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@g3/testing": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.110.0"
  }
}
