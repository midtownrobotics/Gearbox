{
  "name": "@g3/worker-orders",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./split": "./src/lib/split.ts",
    "./fiscal": "./src/lib/fiscal.ts",
    "./naming": "./src/lib/naming.ts",
    "./product-key": "./src/lib/product-key.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8794 --inspector-port 9236",
    "build": "wrangler deploy --env production --dry-run",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ORDERS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply ORDERS_DB --env production --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/site-config": "workspace:*",
    "@g3/slack": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@g3/testing": "workspace:*",
    "@g3/worker-edge": "workspace:*",
    "@g3/worker-inventory": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.110.0"
  }
}
