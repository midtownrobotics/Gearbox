{
  "name": "@g3/worker-scouting",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml --port 8792 --inspector-port 9234",
    "build": "wrangler deploy --env production --dry-run",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply SCOUTING_DB --config wrangler.local.toml --local",
    "db:migrate:remote": "wrangler d1 migrations apply SCOUTING_DB --env production --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/site-config": "workspace:*",
    "@g3/slack": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@g3/testing": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.14.0"
  }
}
