{
  "name": "@g3/worker-scouting",
  "version": "2.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8792 --inspector-port 9234",
    "build": "wrangler deploy --env production --dry-run",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply SCOUTING_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SCOUTING_DB --env production --remote",
    "db:migrate:staging": "wrangler d1 migrations apply SCOUTING_DB --env staging --remote",
    "test": "node test/migration.cjs && vitest run"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/demo": "workspace:*",
    "@g3/site-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@g3/testing": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
