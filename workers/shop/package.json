{
  "name": "@g3/worker-shop",
  "version": "1.2.3",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./process-rules": "./src/lib/process-rules.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 9230",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply SHOP_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SHOP_DB --env production --remote",
    "test": "vitest run",
    "build": "wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "@g3/auth": "workspace:*",
    "@g3/site-config": "workspace:*",
    "@g3/slack": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@g3/testing": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vitest": "catalog:",
    "wrangler": "^4.110.0"
  }
}
